.coupon-card { display:flex; align-items:stretch; background:var(--color-card); border-radius:var(--radius-md); margin-bottom:20rpx; box-shadow:var(--shadow-sm); overflow:hidden; position:relative; }
.cc-left { width:220rpx; padding:32rpx 16rpx; background:linear-gradient(135deg, var(--color-primary), var(--color-primary-bright)); color:#FFFFFF; display:flex; flex-direction:column; align-items:center; justify-content:center; }
.cc-amount { display:flex; align-items:baseline; }
.cc-symbol { font-size:var(--fs-md); margin-right:4rpx; }
.cc-amount-num { font-size:60rpx; font-weight:700; line-height:1; }
.cc-desc { font-size:var(--fs-xs); margin-top:8rpx; color:#FFFFFF; opacity:0.9; }
.cc-dotted { width:0; border-left:2rpx dashed rgba(255,255,255,0.4); margin:16rpx 0; }
.cc-right { flex:1; padding:24rpx; display:flex; flex-direction:column; justify-content:center; }
.cc-name { font-size:var(--fs-md); color:var(--color-text); font-weight:500; }
.cc-min { font-size:var(--fs-xs); color:var(--color-text-sub); margin-top:4rpx; }
.cc-expiry { font-size:var(--fs-xs); color:var(--color-text-muted); margin-top:4rpx; }
.cc-btn { margin-top:16rpx; align-self:flex-start; padding:0 24rpx; height:48rpx; line-height:48rpx; font-size:var(--fs-xs); background:var(--color-primary); color:#FFFFFF; border-radius:var(--radius-pill); border:none; }
.cc-btn::after { border:none; }
.cc-state { margin-top:16rpx; font-size:var(--fs-xs); }
.cc-state-used, .cc-state-expired, .cc-state-claimed { color:var(--color-text-muted); }
.cc-active { }
.cc-claimed { opacity:0.85; }
.cc-used, .cc-expired { opacity:0.55; }
.cc-used .cc-left, .cc-expired .cc-left { background:#999; }
