.skeleton-wrap { padding:24rpx; }
.sk-block { background:linear-gradient(90deg, #F0E8E0 0%, #E8E0D8 50%, #F0E8E0 100%); background-size:200% 100%; animation:sk-shimmer 1.4s ease-in-out infinite; border-radius:var(--radius-sm); }
.sk-card { background:var(--color-card); padding:24rpx; border-radius:var(--radius-md); margin-bottom:20rpx; box-shadow:var(--shadow-sm); }
.sk-image { width:100%; height:320rpx; margin-bottom:16rpx; border-radius:var(--radius-sm); }
.sk-line { height:28rpx; margin:16rpx 0; }
.sk-list-row { display:flex; align-items:center; padding:24rpx; background:var(--color-card); border-radius:var(--radius-md); margin-bottom:16rpx; }
.sk-avatar { width:96rpx; height:96rpx; border-radius:var(--radius-sm); margin-right:24rpx; flex-shrink:0; }
.sk-list-content { flex:1; }
.sk-banner { width:100%; height:280rpx; border-radius:var(--radius-md); }
@keyframes sk-shimmer { 0% { background-position:100% 0; } 100% { background-position:-100% 0; } }
