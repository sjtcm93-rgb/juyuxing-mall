.privacy-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(60, 45, 35, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.privacy-card {
  width: 560rpx;
  background: #FFF9F2;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(120, 90, 60, 0.18);
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #4A3B2E;
  text-align: center;
  margin-bottom: 24rpx;
}

.privacy-content {
  font-size: 26rpx;
  line-height: 42rpx;
  color: #8B7E72;
  margin-bottom: 40rpx;
}

.privacy-link {
  color: #E8730C;
  font-weight: 500;
}

.privacy-actions {
  display: flex;
  gap: 24rpx;
}

.privacy-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0;
  margin: 0;
  border: none;
}

.privacy-btn::after {
  border: none;
}

.privacy-btn-ghost {
  background: #F0E6DC;
  color: #8B7E72;
}

.privacy-btn-primary {
  background: #E8730C;
  color: #fff;
}
