.rp-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}
.rp-panel {
  width: 100%;
  background: var(--color-card);
  border-top-left-radius: var(--radius-lg);
  border-top-right-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  max-height: 70vh;
}
.rp-tabs {
  display: flex;
  border-bottom: 1rpx solid var(--color-divider);
}
.rp-tab {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  font-size: var(--fs-sm);
  color: var(--color-text-sub);
  border-bottom: 4rpx solid transparent;
}
.rp-tab-active {
  color: var(--color-primary-dark);
  font-weight: 600;
  border-bottom-color: var(--color-primary);
}
.rp-list {
  flex: 1;
  max-height: 800rpx;
  padding: 16rpx 0;
}
.rp-item {
  padding: 20rpx 32rpx;
  font-size: var(--fs-sm);
  color: var(--color-text);
}
.rp-item-active {
  color: var(--color-primary-dark);
  background: var(--color-primary-light);
  font-weight: 600;
}
.rp-empty {
  text-align: center;
  color: var(--color-text-muted);
  padding: 32rpx;
}
.rp-footer {
  display: flex;
  border-top: 1rpx solid var(--color-divider);
}
.rp-btn {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: var(--fs-md);
}
.rp-btn-cancel { color: var(--color-text-sub); }
.rp-btn-confirm { color: var(--color-primary-dark); font-weight: 600; }
