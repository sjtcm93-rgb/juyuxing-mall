<view class="rp-mask" wx:if="{{visible}}" bindtap="onCancel">
  <view class="rp-panel" catchtap="">
    <view class="rp-tabs">
      <view
        wx:for="{{[selected[0] || '选择省', selected[1] || '选择市', selected[2] || '选择区']}}"
        wx:key="*this"
        class="rp-tab {{activeTab === index ? 'rp-tab-active' : ''}}"
        data-tab="{{index}}"
        bindtap="onSwitchTab"
      >{{item}}</view>
    </view>

    <scroll-view class="rp-list" scroll-y="true">
      <block wx:if="{{activeTab === 0}}">
        <view wx:for="{{provinces}}" wx:key="name" class="rp-item {{selected[0] === item.name ? 'rp-item-active' : ''}}" data-idx="{{index}}" bindtap="onPickProvince">{{item.name}}</view>
        <view wx:if="{{!loading && provinces.length === 0}}" class="rp-empty">暂无数据</view>
      </block>
      <block wx:elif="{{activeTab === 1}}">
        <view wx:for="{{cities}}" wx:key="name" class="rp-item {{selected[1] === item.name ? 'rp-item-active' : ''}}" data-idx="{{index}}" bindtap="onPickCity">{{item.name}}</view>
        <view wx:if="{{!loading && cities.length === 0}}" class="rp-empty">暂无数据</view>
      </block>
      <block wx:elif="{{activeTab === 2}}">
        <view wx:for="{{districts}}" wx:key="name" class="rp-item {{selected[2] === item.name ? 'rp-item-active' : ''}}" data-idx="{{index}}" bindtap="onPickDistrict">{{item.name}}</view>
        <view wx:if="{{!loading && districts.length === 0}}" class="rp-empty">暂无数据</view>
      </block>
    </scroll-view>

    <view class="rp-footer">
      <view class="rp-btn rp-btn-cancel" bindtap="onCancel">取消</view>
      <view class="rp-btn rp-btn-confirm" bindtap="onConfirm">确定</view>
    </view>
  </view>
</view>
