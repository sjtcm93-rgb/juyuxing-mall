.price-tag { display:inline-flex; align-items:baseline; flex-wrap:wrap; gap:8rpx; }
.price-symbol { font-size:0.7em; }
.price-value { font-weight:600; line-height:1; }
.price-original { color:var(--color-text-muted); font-size:0.7em; text-decoration:line-through; font-weight:400; margin-left:8rpx; }
.price-sm .price-value { font-size:28rpx; } .price-sm .price-symbol { font-size:20rpx; }
.price-md .price-value { font-size:36rpx; } .price-md .price-symbol { font-size:24rpx; }
.price-lg .price-value { font-size:48rpx; } .price-lg .price-symbol { font-size:28rpx; }
.price-xl .price-value { font-size:60rpx; } .price-xl .price-symbol { font-size:32rpx; }
.price-color-primary .price-value { color:var(--color-primary-dark); }
.price-color-danger .price-value { color:var(--color-danger); }
.price-color-sub .price-value { color:var(--color-text-sub); }
