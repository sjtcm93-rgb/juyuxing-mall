.empty-wrap { display:flex; flex-direction:column; align-items:center; justify-content:center; padding:120rpx 32rpx; }
.empty-icon { font-size:96rpx; margin-bottom:24rpx; opacity:0.6; }
.empty-icon-img { width:96rpx; height:96rpx; margin-bottom:24rpx; opacity:0.6; }
.empty-text { color:var(--color-text-sub); font-size:var(--fs-sm); }
.empty-action { margin-top:32rpx; padding:0 48rpx; height:72rpx; line-height:72rpx; background:var(--color-primary); color:#FFFFFF; border-radius:var(--radius-pill); font-size:var(--fs-sm); border:none; }
.empty-action::after { border:none; }
.empty-action-hover { opacity:0.85; }
