.err-wrap { display:flex; flex-direction:column; align-items:center; padding:120rpx 32rpx; }
.err-icon { font-size:96rpx; margin-bottom:16rpx; opacity:0.7; }
.err-icon-img { width:96rpx; height:96rpx; margin-bottom:16rpx; opacity:0.7; }
.err-text { color:var(--color-text-sub); font-size:var(--fs-sm); }
.err-btn { margin-top:32rpx; padding:0 48rpx; height:72rpx; line-height:72rpx; background:var(--color-primary); color:#FFFFFF; border-radius:var(--radius-pill); font-size:var(--fs-sm); border:none; }
.err-btn::after { border:none; }
.err-btn-hover { opacity:0.85; }
