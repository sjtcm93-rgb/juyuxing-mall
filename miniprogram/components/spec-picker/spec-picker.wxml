<view wx:if="{{show}}" class="sp-mask" bindtap="onMaskTap" catchtouchmove="stop">
  <view class="sp-panel" catchtap="onStop">
    <view class="sp-header">
      <image class="sp-img" src="{{cover}}" mode="aspectFill"></image>
      <view class="sp-info">
        <view class="sp-price">¥{{priceYuan}}</view>
        <view class="sp-stock" wx:if="{{maxStock <= 10 && maxStock > 0}}">仅剩 {{maxStock}} 件</view>
        <view class="sp-selected">已选：{{specName || '默认规格'}}</view>
      </view>
      <view class="sp-close" bindtap="onMaskTap">×</view>
    </view>
    <view class="sp-body" wx:if="{{goods.specs && goods.specs.length > 0}}">
      <view class="sp-label">规格</view>
      <view class="sp-spec-list">
        <view wx:for="{{goods.specs}}" wx:key="index" class="sp-spec {{selectedSpec === index ? 'sp-spec-active' : ''}} {{item.stock <= 0 ? 'sp-spec-disabled' : ''}}" data-index="{{index}}" bindtap="selectSpec">
          <text>{{item.name}}</text>
          <text wx:if="{{item.stock <= 10 && item.stock > 0}}" class="sp-spec-low">剩{{item.stock}}</text>
        </view>
      </view>
    </view>
    <view class="sp-body">
      <view class="sp-label">数量</view>
      <view class="sp-qty">
        <view class="sp-qty-btn" bindtap="dec">−</view>
        <text class="sp-qty-val">{{currentQty}}</text>
        <view class="sp-qty-btn" bindtap="inc">+</view>
      </view>
    </view>
    <view class="sp-footer">
      <button class="sp-btn sp-btn-cart" bindtap="onCart">加入购物车</button>
      <button class="sp-btn sp-btn-buy" bindtap="onConfirm">立即购买</button>
    </view>
  </view>
</view>
