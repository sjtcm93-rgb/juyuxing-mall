@import "../../../style/tokens.wxss";
.page{min-height:100vh;background:#F5F6F8;padding:36rpx}.profile{display:flex;flex-direction:column;align-items:center;padding:60rpx}.profile image{width:130rpx;height:130rpx;border-radius:50%}.name{font-size:34rpx;font-weight:700;color:#E8730C;margin-top:20rpx}.level{color:#E8730C;font-size:24rpx;margin-top:8rpx}.card{background:#fff;border-radius:22rpx;padding:0 30rpx}.card view{display:flex;justify-content:space-between;padding:30rpx 0;border-bottom:1rpx solid #F0F0F0;color:#615950}.code{font-family:monospace;color:#E8730C}.privacy{font-size:24rpx;color:#7C746B;line-height:1.7;padding:30rpx}
.edit-row{display:flex;justify-content:space-between;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #F0F0F0}.edit-input{flex:1;margin-left:24rpx;height:64rpx;background:#F7F5F2;border-radius:12rpx;padding:0 20rpx;font-size:27rpx;text-align:right;color:#2E2A26;box-sizing:border-box}.error{display:block;color:#FA5151;font-size:26rpx;text-align:center;padding:24rpx 0 0}.actions{margin-top:36rpx;display:flex;flex-direction:column;gap:20rpx}.primary-btn{background:#E8730C!important;color:#fff!important;border-radius:999rpx;font-size:28rpx}.ghost-btn{background:#fff!important;color:#E8730C!important;border:2rpx solid #E8730C;border-radius:999rpx;font-size:28rpx}
