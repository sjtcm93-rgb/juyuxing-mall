@import "../../../style/tokens.wxss";
.page{min-height:100vh;background:#F5F6F8;padding:28rpx}.balance-card{background:linear-gradient(135deg,#FF9A3D,#E8730C);color:#fff;border-radius:26rpx;padding:40rpx;display:flex;flex-direction:column}.balance{font-size:58rpx;font-weight:700;margin:18rpx 0}.sub{font-size:23rpx;opacity:.7}.card{background:#fff;border-radius:22rpx;padding:30rpx;margin-top:24rpx}.title{display:block;font-size:30rpx;font-weight:700;color:#E8730C;margin-bottom:20rpx}input{background:#F5F6F8;border-radius:12rpx;padding:23rpx;margin:14rpx 0}button{background:#E8730C!important;color:#fff!important;border-radius:999rpx;margin-top:24rpx}.record{display:flex;justify-content:space-between;padding:22rpx 0;border-bottom:1rpx solid #F0F0F0}.empty{color:#91877C;font-size:24rpx}.frozen-tip{margin-top:18rpx;background:rgba(255,255,255,.18);border-radius:12rpx;padding:16rpx 20rpx;font-size:23rpx;line-height:1.6}
