@import "../../../style/tokens.wxss";
.metric-value{font-size:29rpx!important;color:#E8730C!important;margin-top:8rpx;font-weight:700}
.page{min-height:100vh;background:#F5F6F8;padding:0 28rpx 60rpx}.hero{margin:0 -28rpx;padding:78rpx 40rpx 96rpx;background:linear-gradient(135deg,#FF9A3D,#E8730C);color:#fff;display:flex;flex-direction:column}.eyebrow{font-size:19rpx;letter-spacing:5rpx;opacity:.62}.title{font-size:50rpx;font-weight:700;margin:12rpx 0}.code{font-family:monospace;font-size:25rpx;opacity:.84}.money-card{margin-top:-58rpx;background:#fff;border-radius:28rpx;padding:36rpx;box-shadow:0 16rpx 50rpx rgba(232,115,12,.1)}.label{color:#83786D;font-size:25rpx}.main-money{display:block;color:#E8730C;font-size:58rpx;font-weight:700;margin:12rpx 0 30rpx}.money-row{display:flex;border-top:1rpx solid #F0F0F0;padding-top:26rpx}.money-row view{flex:1;display:flex;flex-direction:column}.money-row text,.metric text{font-size:23rpx;color:#8B8177}.money-row strong,.metric strong{font-size:29rpx;color:#E8730C;margin-top:8rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin:24rpx 0}.metric{background:#fff;border-radius:20rpx;padding:28rpx;display:flex;flex-direction:column}.menu{background:#fff;border-radius:24rpx;overflow:hidden}.menu view{display:flex;justify-content:space-between;padding:32rpx;border-bottom:1rpx solid #F5F5F5;color:#333333}.notice{margin:36rpx 0;padding:30rpx;border-radius:20rpx;background:#FFF1E9;color:#C25E08;font-size:27rpx;line-height:1.7}
