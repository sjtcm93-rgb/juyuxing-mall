@import "../../../style/tokens.wxss";
.distributor-page{min-height:100vh;background:#F5F6F8;padding:120rpx 36rpx;box-sizing:border-box}.brand-mark{text-align:center;color:#E8730C;font-size:46rpx;font-weight:700;letter-spacing:12rpx;margin-bottom:48rpx}.bind-card{background:#fff;border-radius:28rpx;padding:56rpx 40rpx;box-shadow:0 20rpx 60rpx rgba(232,115,12,.08);display:flex;flex-direction:column;align-items:center}.bind-title{font-size:36rpx;font-weight:700;color:#E8730C;margin-bottom:24rpx}.bind-desc{font-size:27rpx;line-height:1.8;color:#756C62;text-align:center}.primary-btn{width:100%;margin-top:48rpx;background:#E8730C!important;color:#fff!important;border-radius:999rpx;font-size:30rpx}.success-mark{width:96rpx;height:96rpx;line-height:96rpx;text-align:center;border-radius:50%;background:#E6F7E6;color:#04BE02;font-size:52rpx;margin-bottom:28rpx}.code{font-family:monospace;color:#E8730C}.error{color:#FA5151;font-size:26rpx;margin-top:28rpx;text-align:center}
