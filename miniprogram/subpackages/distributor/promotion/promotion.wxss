@import "../../../style/tokens.wxss";
.product-options{margin-top:16rpx}.target-btn{display:block!important;font-size:24rpx;background:#F5F6F8!important;color:#E8730C!important;border-radius:999rpx}.target-btn.active{background:#FFE9D2!important}
.page{min-height:100vh;background:#F5F6F8;padding:28rpx;box-sizing:border-box}.card{background:#fff;border-radius:24rpx;padding:34rpx;margin-bottom:24rpx}.title{display:block;font-size:32rpx;font-weight:700;color:#E8730C;margin-bottom:24rpx}.picker{border:1rpx solid #E8E8E8;border-radius:14rpx;padding:25rpx;display:flex;justify-content:space-between;color:#615950}.primary,.share{background:#E8730C!important;color:#fff!important;border-radius:999rpx;margin-top:24rpx}.asset{display:flex;flex-direction:column;align-items:center}.qr{width:430rpx;height:430rpx}.qr-placeholder{width:360rpx;height:360rpx;background:#F5F6F8;color:#8A8178;display:flex;align-items:center;justify-content:center}.code{font-family:monospace;color:#E8730C;margin:18rpx}.outline{width:100%;border:1rpx solid #E8730C!important;color:#E8730C!important;background:#fff!important;border-radius:999rpx;margin-top:18rpx}.share{width:100%}.hint{font-size:23rpx;color:#8A8178;line-height:1.7;margin-top:24rpx}.target-btn{display:none}
.hint{font-size:23rpx;color:#8A8178;line-height:1.7;margin-top:24rpx}.debug{font-size:20rpx;color:#c33;background:#fee;padding:12rpx;border-radius:8rpx;margin-top:16rpx;word-break:break-all;font-family:monospace}
