@import "../../../style/tokens.wxss";
.page{min-height:100vh;background:#F5F6F8;padding:26rpx}.privacy-note{background:#FFF2E3;color:#B25E1F;padding:24rpx;border-radius:18rpx;font-size:24rpx;line-height:1.6;margin-bottom:22rpx}.item{background:#fff;border-radius:20rpx;padding:28rpx;margin-bottom:18rpx;display:flex;align-items:center;justify-content:space-between}.info{display:flex;flex-direction:column;gap:8rpx}.products{color:#E8730C;font-weight:600}.order,.status{font-size:23rpx;color:#91877C}.amount{color:#E8730C;font-weight:700}.negative{color:#FA5151}.empty{text-align:center;color:#91877C;padding:100rpx 0}
