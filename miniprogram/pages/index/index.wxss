/* 首页样式 - 品牌暖橙 v3（按 2026-09-02 原型升级） */
.home-wrap {
  background: var(--color-showcase-bg);
}

/* ===== 顶部渐变区：品牌 + 搜索 + 双入口 ===== */
.home-top {
  padding: 22rpx 38rpx 0;
  background: transparent;
}

.home-brand-row {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  padding: 0 0 32rpx;
}

.home-brand-name {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--color-showcase-primary);
  letter-spacing: 2rpx;
}

.home-brand-tag {
  font-size: 24rpx;
  color: var(--color-showcase-muted);
  letter-spacing: 2rpx;
}

/* 搜索框（点击跳搜索页） */
.search-bar {
  height: 76rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  margin: 0 0 24rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: none;
}

.search-bar-hover { opacity: 0.85; }
.search-bar-icon-only { justify-content: flex-start; padding: 0 32rpx; }

.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.search-placeholder {
  font-size: 26rpx;
  color: var(--color-text-faint);
}

/* 双入口卡 */
.promo-row {
  display: flex;
  gap: 16rpx;
  margin: 0;
}

.promo-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  min-width: 0;
  height: 118rpx;
  padding: 20rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-shadow: none;
}

.promo-card-hover { opacity: 0.85; transform: scale(0.98); }

.promo-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--color-warm-soft);
  padding: 8rpx;
  box-sizing: border-box;
}

.promo-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.promo-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.promo-desc {
  font-size: 22rpx;
  color: var(--color-showcase-muted);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 轮播图 ===== */
.banner-section {
  padding: 8rpx 24rpx;
}
.banner-swiper {
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--color-bg-soft);
}
.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
}
.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}
.banner-title {
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
  background: rgba(0,0,0,0.35);
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
}

/* ===== 分区标题 ===== */
.section-header {
  padding: 40rpx 32rpx 24rpx;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text);
  position: relative;
}

.section-subtitle {
  font-size: 22rpx;
  color: var(--color-text-faint);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* ===== 首页全宽商品卡片 ===== */
.product-section { padding-bottom: 16rpx; }

.product-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 38rpx 24rpx;
}

.product-grid goods-card {
  width: 100%;
  margin-top: 0;
}

.product-section .section-header {
  position: relative;
  z-index: 4;
  padding-top: 54rpx;
  padding-bottom: 0;
  padding-right: 40rpx;
  padding-left: 40rpx;
  line-height: 52rpx;
  pointer-events: none;
}

.product-section .section-title {
  color: var(--color-showcase-title);
  font-size: 42rpx;
  letter-spacing: 2rpx;
}

.product-section .section-subtitle { font-size: 24rpx; color: var(--color-showcase-muted); }
.product-grid-reference { margin-top: -52rpx; }
.product-grid goods-card + goods-card { margin-top: 52rpx; }

.loading-more {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx 0;
}
.loading-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary);
  animation: dotBounce 1s infinite ease-in-out;
}
.loading-dot:nth-child(2) { animation-delay: 0.15s; }
.loading-dot:nth-child(3) { animation-delay: 0.3s; }
@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

.loading-end {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-faint);
  padding: 32rpx 0;
}

/* ===== 品牌故事 ===== */
.story-section { margin-top: 0; }
.story-section .section-header { padding-top: 0; }
.story-content {
  margin: 0 24rpx;
  position: relative;
  padding: 24rpx 36rpx 26rpx;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
}

.story-quote-mark {
  position: absolute;
  top: 16rpx;
  left: 18rpx;
  font-size: 48rpx;
  color: var(--color-primary-soft);
  line-height: 1;
  font-family: Georgia, serif;
}

.story-text {
  color: var(--color-text-sub);
  font-size: 28rpx;
  line-height: 1.75;
  display: block;
  margin-bottom: 10rpx;
  text-align: justify;
}

.story-link {
  display: inline-block;
  color: var(--color-primary);
  font-size: 26rpx;
  margin-top: 4rpx;
  font-weight: 500;
}

.footer-space {
  height: 60rpx;
}
