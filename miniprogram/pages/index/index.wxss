/* 首页样式 - 品牌暖橙 v3（按 2026-09-02 原型升级） */
.home-wrap {
  background: #F5F6F8;
}

/* ===== 顶部渐变区：品牌 + 搜索 + 双入口 ===== */
.home-top {
  padding: 32rpx 24rpx 8rpx;
  background: linear-gradient(180deg, rgba(232, 115, 12, 0.12) 0%, rgba(245, 246, 248, 0) 100%);
}

.home-brand-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 0 8rpx 24rpx;
}

.home-brand-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 2rpx;
}

.home-brand-tag {
  font-size: 24rpx;
  color: var(--color-text-muted);
  letter-spacing: 2rpx;
}

/* 搜索框（点击跳搜索页） */
.search-bar {
  height: 72rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  margin: 0 8rpx 20rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(232, 115, 12, 0.08);
}

.search-bar-hover { opacity: 0.85; }
.search-bar-icon-only { justify-content: center; padding: 0; }

.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.search-placeholder {
  font-size: 26rpx;
  color: var(--color-text-faint);
}

/* 双入口卡 */
.promo-row {
  display: flex;
  gap: 16rpx;
  margin: 0 8rpx 24rpx;
}

.promo-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: var(--shadow-sm);
}

.promo-card-hover { opacity: 0.85; transform: scale(0.98); }

.promo-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--color-warm-soft);
  padding: 8rpx;
  box-sizing: border-box;
}

.promo-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.promo-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.promo-desc {
  font-size: 20rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 轮播图 ===== */
.banner-section {
  padding: 8rpx 24rpx;
}
.banner-swiper {
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--color-bg-soft);
}
.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
}
.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}
.banner-title {
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
  background: rgba(0,0,0,0.35);
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
}

/* ===== 分区标题 ===== */
.section-header {
  padding: 40rpx 32rpx 24rpx;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text);
  position: relative;
}

.section-subtitle {
  font-size: 22rpx;
  color: var(--color-text-faint);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* ===== 双列商品网格 ===== */
.product-section { padding-bottom: 16rpx; }

.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 24rpx 8rpx;
}

.product-grid goods-card {
  width: calc((100% - 16rpx) / 2);
}

.loading-more {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx 0;
}
.loading-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary);
  animation: dotBounce 1s infinite ease-in-out;
}
.loading-dot:nth-child(2) { animation-delay: 0.15s; }
.loading-dot:nth-child(3) { animation-delay: 0.3s; }
@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

.loading-end {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-faint);
  padding: 32rpx 0 48rpx;
}

/* ===== 品牌故事 ===== */
.story-content {
  margin: 0 24rpx;
  position: relative;
  padding: 40rpx 36rpx;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
}

.story-quote-mark {
  font-size: 80rpx;
  color: var(--color-primary-soft);
  line-height: 1;
  margin-bottom: -10rpx;
  font-family: Georgia, serif;
}

.story-text {
  color: var(--color-text-sub);
  font-size: 28rpx;
  line-height: 1.9;
  display: block;
  margin-bottom: 16rpx;
  text-align: justify;
}

.story-link {
  display: inline-block;
  color: var(--color-primary);
  font-size: 26rpx;
  margin-top: 8rpx;
  font-weight: 500;
}

.footer-space {
  height: 60rpx;
}
