.address-card {
  padding: var(--space-md);
  margin: var(--space-sm) var(--space-md);
}
.address-top { display: flex; align-items: center; gap: var(--space-sm); margin-bottom: 12rpx; }
.address-name { font-size: var(--fs-md); font-weight: 600; color: var(--color-text); }
.address-phone { font-size: var(--fs-sm); color: var(--color-text-sub); }
.default-tag {
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}
.address-detail { font-size: var(--fs-sm); color: var(--color-text); line-height: 1.6; }
.address-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-md);
  margin-top: var(--space-sm);
  padding-top: var(--space-sm);
  border-top: 2rpx solid var(--color-divider);
}
.addr-action {
  font-size: var(--fs-xs);
  color: var(--color-text-sub);
  padding: 4rpx 8rpx;
}
.addr-action-danger { color: var(--color-danger); }
.add-btn-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-md);
  background: var(--color-card);
  border-top: 2rpx solid var(--color-divider);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom, 0));
}
.add-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #FFFFFF;
  border-radius: var(--radius-pill);
  font-size: var(--fs-md);
  border: none;
}
.add-btn::after { border: none; }
