<view class="page-wrap">
  <view class="empty-wrap" wx:if="{{addresses.length === 0}}">
    <text class="empty-text">暂无收货地址</text>
  </view>
  <view wx:for="{{addresses}}" wx:key="_id" class="address-card" data-id="{{item._id}}" bindtap="selectAddr">
    <view class="addr-top">
      <text class="addr-name">{{item.name}}</text>
      <text class="addr-phone">{{item.phone}}</text>
      <text class="addr-default" wx:if="{{item.isDefault}}">默认</text>
    </view>
    <text class="addr-detail">{{item.region ? item.region.join(' ') : ''}} {{item.detail}}</text>
    <view class="addr-actions">
      <view class="addr-action" bindtap="setDefault" data-id="{{item._id}}" data-default="{{!item.isDefault}}">
        <text wx:if="{{item.isDefault}}">✅ 默认地址</text>
        <text wx:else>○ 设为默认</text>
      </view>
      <view class="addr-action" bindtap="editAddr" data-id="{{item._id}}">✏️ 编辑</view>
      <view class="addr-action" bindtap="deleteAddr" data-id="{{item._id}}">🗑️ 删除</view>
    </view>
  </view>
  <view class="add-btn-wrap">
    <navigator url="/pages/address-edit/address-edit" class="add-btn">+ 添加新地址</navigator>
  </view>
</view>
