<view class="page-wrap">
  <view class="form-wrap">
    <view class="form-group">
      <text class="form-label">收货人</text>
      <input class="form-input" value="{{name}}" placeholder="请输入收货人姓名" bindinput="onNameInput" />
    </view>
    <view class="form-group">
      <text class="form-label">手机号</text>
      <input class="form-input" type="phone" value="{{phone}}" placeholder="请输入手机号" bindinput="onPhoneInput" />
    </view>
    <view class="form-group">
      <text class="form-label">所在地区</text>
      <picker mode="region" value="{{region}}" bindchange="onRegionChange" custom-item="{{['省','市','区']}}">
        <view class="picker-value">{{regionText}}</view>
      </picker>
    </view>
    <view class="form-group">
      <text class="form-label">详细地址</text>
      <input class="form-input" value="{{detail}}" placeholder="街道、门牌号等" bindinput="onDetailInput" />
    </view>
    <view class="form-group switch-group">
      <text class="form-label">设为默认地址</text>
      <switch checked="{{isDefault}}" color="#E8A87C" bindchange="onDefaultChange" />
    </view>
  </view>
  <view class="save-btn-wrap">
    <button class="save-btn" bindtap="saveAddress">保存地址</button>
  </view>
</view>
