.form {
  background: var(--color-card);
  margin: var(--space-md);
  border-radius: var(--radius-md);
  padding: 0 var(--space-md);
  box-shadow: var(--shadow-sm);
}
.form-row {
  display: flex;
  align-items: center;
  padding: var(--space-md) 0;
  border-bottom: 2rpx solid var(--color-divider);
}
.form-row:last-child { border-bottom: none; }
.form-label {
  width: 160rpx;
  font-size: var(--fs-sm);
  color: var(--color-text-sub);
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: var(--fs-sm);
  color: var(--color-text);
  height: 48rpx;
}
.form-row-region .region-picker { flex: 1; }
.region-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  font-size: var(--fs-sm);
}
.region-text { color: var(--color-text); }
.region-placeholder { color: var(--color-text-muted); }
.region-arrow { font-size: 36rpx; color: var(--color-text-muted); }
.form-row-textarea { align-items: flex-start; }
.form-textarea {
  flex: 1;
  min-height: 120rpx;
  font-size: var(--fs-sm);
  color: var(--color-text);
  padding: 8rpx 0;
}
.form-row-default { justify-content: space-between; }

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-md);
  background: var(--color-card);
  border-top: 2rpx solid var(--color-divider);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom, 0));
}
.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #FFFFFF;
  border-radius: var(--radius-pill);
  font-size: var(--fs-md);
  border: none;
}
.save-btn::after { border: none; }
.save-btn[disabled] { background: var(--color-text-disabled); }
