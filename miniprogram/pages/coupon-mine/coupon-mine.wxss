.cm-wrap { padding: 0 var(--space-md) var(--space-lg); }
.cm-tabs {
  display: flex;
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 8rpx;
  margin: 24rpx 0;
  box-shadow: var(--shadow-sm);
}
.cm-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: var(--fs-sm);
  color: var(--color-text-sub);
  border-radius: var(--radius-sm);
  transition: all 0.2s;
}
.cm-tab-active {
  color: var(--color-primary-dark);
  background: var(--color-primary-light);
  font-weight: 600;
}
.cm-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
