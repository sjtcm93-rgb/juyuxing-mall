.referral-page {
  min-height: 100vh;
  background: #FDF8F3;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.referral-header {
  text-align: center;
  padding: 48rpx 0 40rpx;
}
.header-title {
  font-size: 40rpx;
  font-weight: 500;
  color: #4A3B2A;
  margin-bottom: 12rpx;
}
.header-sub {
  font-size: 26rpx;
  color: #8B7E72;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(138, 124, 108, 0.06);
}

.rule-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #4A3B2A;
  margin-bottom: 28rpx;
}
.rule-step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}
.rule-step:last-child { margin-bottom: 0; }
.step-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #E8A87C;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.step-text {
  font-size: 28rpx;
  color: #5A4D3F;
  line-height: 1.6;
  padding-top: 4rpx;
}

.stats-card {
  display: flex;
  justify-content: space-around;
  align-items: center;
}
.stat-item {
  text-align: center;
  flex: 1;
}
.stat-num {
  font-size: 48rpx;
  font-weight: 500;
  color: #E8A87C;
  margin-bottom: 8rpx;
}
.stat-label {
  font-size: 24rpx;
  color: #8B7E72;
}
.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #EBE5DE;
}

.action-area {
  padding: 12rpx 0;
}
.btn-primary {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: #E8A87C;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 46rpx;
  border: none;
  margin-bottom: 20rpx;
}
.btn-primary::after { border: none; }
.btn-secondary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #FFFFFF;
  color: #8BA888;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: 2rpx solid #8BA888;
  margin-bottom: 20rpx;
}
.btn-secondary::after { border: none; }
.btn-text {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  background: transparent;
  color: #8B7E72;
  font-size: 26rpx;
  border: none;
}
.btn-text::after { border: none; }

.login-tip {
  text-align: center;
  font-size: 26rpx;
  color: #8B7E72;
  margin-bottom: 24rpx;
}

.referral-tips {
  margin-top: 32rpx;
  padding: 0 16rpx;
}
.tip-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #8B7E72;
  margin-bottom: 16rpx;
}
.tip-item {
  font-size: 24rpx;
  color: #A89B8E;
  line-height: 1.7;
  margin-bottom: 8rpx;
}
