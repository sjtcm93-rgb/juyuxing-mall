.section {
  background: var(--color-card);
  margin: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  box-shadow: var(--shadow-sm);
}
.section-title {
  display: block;
  font-size: var(--fs-sm);
  color: var(--color-text-sub);
  margin-bottom: var(--space-sm);
  font-weight: 500;
}

/* 地址 */
.address-section { padding: var(--space-md); }
.address-info { display: flex; flex-direction: column; gap: 8rpx; }
.address-top { display: flex; align-items: center; gap: var(--space-sm); }
.address-name { font-size: var(--fs-md); font-weight: 600; color: var(--color-text); }
.address-phone { font-size: var(--fs-sm); color: var(--color-text-sub); }
.address-default {
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}
.address-detail { font-size: var(--fs-sm); color: var(--color-text); line-height: 1.5; }
.address-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--color-text-sub);
  font-size: var(--fs-sm);
  padding: 16rpx 0;
}
.address-empty .arrow { font-size: 36rpx; color: var(--color-text-muted); }

/* 商品 */
.order-item {
  display: flex;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 2rpx solid var(--color-divider);
}
.order-item:last-child { border-bottom: none; }
.item-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-soft);
  flex-shrink: 0;
}
.item-info { flex: 1; margin-left: var(--space-sm); display: flex; flex-direction: column; gap: 8rpx; }
.item-name {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: var(--fs-sm);
  color: var(--color-text);
  line-height: 1.4;
}
.item-spec { font-size: var(--fs-xs); color: var(--color-text-sub); }
.item-price-area { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.item-price { color: var(--color-primary-dark); font-weight: 600; font-size: var(--fs-sm); }
.item-qty { color: var(--color-text-muted); font-size: var(--fs-xs); }

/* 优惠券 */
.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx var(--space-md);
}
.coupon-row .section-title { margin: 0; }
.coupon-right { display: flex; align-items: center; font-size: var(--fs-sm); }
.coupon-picked { color: var(--color-primary-dark); }
.coupon-pickable { color: var(--color-primary-dark); }
.coupon-none { color: var(--color-text-muted); }

/* 价格明细 */
.price-section { padding: var(--space-md); }
.price-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: var(--fs-sm);
  color: var(--color-text);
}
.price-row.total { border-top: 2rpx solid var(--color-divider); padding-top: 16rpx; margin-top: 8rpx; }
.total-num { color: var(--color-primary-dark); font-size: var(--fs-lg); font-weight: 600; }
.discount { color: var(--color-primary-dark); }

/* 备注 */
.remark-section { padding: var(--space-md); }

/* 底部 */
.checkout-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: var(--color-card);
  padding: var(--space-sm) var(--space-md);
  border-top: 2rpx solid var(--color-divider);
  z-index: 100;
  padding-bottom: calc(var(--space-sm) + env(safe-area-inset-bottom, 0));
}
.bottom-total { flex: 1; }
.total-text { color: var(--color-text-sub); font-size: var(--fs-sm); }
.total-price { color: var(--color-primary-dark); font-size: var(--fs-xl); font-weight: 700; margin-left: 8rpx; }
.submit-btn {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 48rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #FFFFFF;
  border-radius: var(--radius-pill);
  font-size: var(--fs-md);
  border: none;
}
.submit-btn[disabled], .submit-btn.btn-disabled {
  background: var(--color-text-disabled);
}
.submit-btn::after { border: none; }
