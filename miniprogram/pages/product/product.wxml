<!-- 商品详情页 -->
<view class="page-wrap">
  <!-- 商品图片轮播 -->
  <swiper class="product-swiper" indicator-dots="{{true}}" autoplay="{{false}}" circular>
    <swiper-item wx:for="{{product.images || ['../../images/product-placeholder.png']}}" wx:key="index">
      <image class="swiper-image" src="{{item}}" mode="aspectFill"></image>
    </swiper-item>
  </swiper>

  <!-- 商品信息 -->
  <view class="product-info-section">
    <view class="price-area">
      <text class="current-price">¥{{(product.price/100).toFixed(2)}}</text>
      <text class="original-price">¥{{(product.originalPrice/100).toFixed(2)}}</text>
      <text class="sales-count">已售 {{product.sales || 0}} 件</text>
    </view>
    <text class="product-name">{{product.name}}</text>
    <text class="product-subtitle">{{product.subtitle}}</text>
    
    <!-- 规格选择 -->
    <view class="spec-section" wx:if="{{product.specs && product.specs.length > 0}}">
      <text class="spec-label">规格</text>
      <view class="spec-list">
        <view 
          class="spec-item {{selectedSpec === index ? 'spec-active' : ''}}"
          wx:for="{{product.specs}}" 
          wx:key="index"
          data-index="{{index}}"
          bindtap="selectSpec"
        >
          <text>{{item.name}}</text>
          <text class="spec-stock" wx:if="{{item.stock <= 10}}">仅剩{{item.stock}}件</text>
        </view>
      </view>
    </view>

    <!-- 数量选择 -->
    <view class="quantity-section">
      <text class="spec-label">数量</text>
      <view class="quantity-control">
        <view class="qty-btn" bindtap="decreaseQty">−</view>
        <text class="qty-value">{{quantity}}</text>
        <view class="qty-btn" bindtap="increaseQty">+</view>
      </view>
    </view>
  </view>

  <!-- 商品详情 -->
  <view class="detail-section">
    <view class="detail-header">
      <text class="detail-title">商品详情</text>
    </view>
    <view class="detail-content">
      <rich-text nodes="{{product.description || '详情加载中...'}}"></rich-text>
    </view>
  </view>

  <!-- 品牌故事 -->
  <view class="brand-card">
    <text class="brand-card-title">橘与杏</text>
    <text class="brand-card-text">源于草本，温润日常。每一份产品都来自对自然的敬畏与热爱。</text>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-actions">
    <view class="action-left">
      <navigator url="/pages/index/index" open-type="switchTab" class="action-item">
        <text class="action-icon">🏠</text>
        <text class="action-text">首页</text>
      </navigator>
      <view class="action-item" bindtap="addToCart">
        <text class="action-icon">🛒</text>
        <text class="action-text">购物车</text>
      </view>
    </view>
    <view class="action-right">
      <button class="btn-add-cart" bindtap="addToCart">加入购物车</button>
      <button class="btn-buy-now" bindtap="buyNow">立即购买</button>
    </view>
  </view>
</view>
