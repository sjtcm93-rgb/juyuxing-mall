.user-header {
  position: relative;
  min-height: 380rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #FFFFFF;
  overflow: hidden;
  margin-bottom: var(--space-md);
}
.user-bg-deco {
  position: absolute;
  width: 600rpx;
  height: 600rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  top: -300rpx;
  right: -200rpx;
}
.user-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0 44rpx;
  z-index: 2;
}
.avatar-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
  overflow: hidden;
  background: rgba(255,255,255,0.2);
}
.avatar { width: 100%; height: 100%; }
.avatar-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.5);
  color: #FFFFFF;
  text-align: center;
  font-size: 22rpx;
  padding: 4rpx 0;
}
.user-name {
  margin-top: var(--space-sm);
  font-size: var(--fs-lg);
  font-weight: 600;
}
.user-desc {
  font-size: var(--fs-sm);
  opacity: 0.85;
  margin-top: 8rpx;
}

.section { padding: var(--space-md); margin-bottom: var(--space-sm); }
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-sm);
}
.section-title {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--color-text);
}
.section-more {
  font-size: var(--fs-sm);
  color: var(--color-text-sub);
}

.order-tabs {
  display: flex;
  justify-content: space-around;
  padding: var(--space-sm) 0;
}
.order-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
}
.tab-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  background: var(--color-danger);
  color: #FFFFFF;
  font-size: 20rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 14rpx;
  padding: 0 8rpx;
}
.tab-icon-img { width:56rpx; height:56rpx; }
.tab-text { font-size: var(--fs-xs); color: var(--color-text-sub); }

.menu-item {
  display: flex;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 2rpx solid var(--color-divider);
}
.menu-item:last-child { border-bottom: none; }
.menu-icon-img { width:40rpx; height:40rpx; margin-right: var(--space-sm); flex-shrink:0; }
.menu-text { flex: 1; font-size: var(--fs-sm); color: var(--color-text); }
.menu-tag {
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
}
.menu-arrow { font-size: 36rpx; color: var(--color-text-muted); }
