.user-header {
  display:flex; flex-direction:column; align-items:center;
  padding:80rpx 0 60rpx;
  background:linear-gradient(180deg,#FDF8F3,#FFFBF7);
}
.avatar-wrap {
  width:140rpx; height:140rpx; border-radius:50%;
  border:4rpx solid #F5D6B8; overflow:hidden; position:relative;
  margin-bottom:20rpx;
}
.avatar { width:100%; height:100%; }
.avatar-badge {
  position:absolute; bottom:-4rpx; left:-4rpx; right:-4rpx;
  background:linear-gradient(135deg,#E8A87C,#F5D6B8);
  text-align:center; padding:4rpx 0;
}
.avatar-badge text {
  font-size:20rpx; color:#4A3F35; font-weight:500;
}
.user-name { font-size:34rpx; font-weight:600; color:#4A3F35; }
.user-desc { font-size:24rpx; color:#B0A59A; margin-top:8rpx; }
.section {
  background:#FFFFFF; margin:20rpx; border-radius:20rpx;
  box-shadow:0 2rpx 12rpx rgba(74,63,53,0.06);
  overflow:hidden;
}
.section-header {
  display:flex; justify-content:space-between; align-items:center;
  padding:28rpx 32rpx 16rpx;
}
.section-title { font-size:30rpx; font-weight:600; color:#4A3F35; }
.section-more { font-size:24rpx; color:#B0A59A; }
.order-tabs {
  display:flex; justify-content:space-around;
  padding:16rpx 0 28rpx;
}
.order-tab {
  display:flex; flex-direction:column; align-items:center;
}
.tab-icon { font-size:48rpx; margin-bottom:8rpx; }
.tab-text { font-size:24rpx; color:#4A3F35; }
.menu-item {
  display:flex; align-items:center; padding:28rpx 32rpx;
  border-bottom:2rpx solid #F0E8E0;
}
.menu-item:last-child { border-bottom:none; }
.menu-icon { font-size:36rpx; margin-right:20rpx; }
.menu-text { flex:1; font-size:28rpx; color:#4A3F35; }
.menu-tag {
  font-size:22rpx; color:#E8A87C;
  background:#FFFBF7; padding:4rpx 16rpx; border-radius:8rpx;
  margin-right:12rpx;
}
.menu-arrow { font-size:32rpx; color:#D4C9C0; }
