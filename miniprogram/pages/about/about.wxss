.about-wrap { padding-bottom: 60rpx; }
.about-header {
  padding: 80rpx 0 var(--space-lg);
  text-align: center;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #FFFFFF;
  margin-bottom: var(--space-md);
}
.brand-mark {
  font-size: 80rpx;
  font-weight: 600;
  letter-spacing: 16rpx;
}
.brand-sub {
  display: block;
  font-size: var(--fs-sm);
  opacity: 0.9;
  margin-top: 12rpx;
}

.story-title {
  display: block;
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--space-sm);
}
.story-text {
  display: block;
  font-size: var(--fs-sm);
  color: var(--color-text);
  line-height: 1.8;
  margin-bottom: var(--space-sm);
}
.quote-mark {
  font-size: 80rpx;
  color: var(--color-primary);
  font-family: serif;
  line-height: 1;
}

.value-item {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-sm) 0;
  border-bottom: 2rpx solid var(--color-divider);
}
.value-item:last-child { border-bottom: none; }
.value-icon-img { width:56rpx; height:56rpx; flex-shrink:0; }
.value-content { flex: 1; }
.value-name {
  display: block;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--color-text);
}
.value-desc {
  display: block;
  font-size: var(--fs-xs);
  color: var(--color-text-sub);
  margin-top: 4rpx;
}

.contact-row {
  display: flex;
  padding: var(--space-sm) 0;
  border-bottom: 2rpx solid var(--color-divider);
}
.contact-row:last-child { border-bottom: none; }
.contact-label { width: 200rpx; color: var(--color-text-sub); font-size: var(--fs-sm); }
.contact-value { flex: 1; color: var(--color-text); font-size: var(--fs-sm); }
