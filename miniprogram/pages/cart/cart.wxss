.cart-item {
  display: flex;
  align-items: center;
  position: relative;
  margin: var(--space-sm) var(--space-md);
}
.cart-check {
  display: flex;
  align-items: center;
  padding: 16rpx 12rpx;
}
.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-divider-strong);
  background: #FFFFFF;
  position: relative;
}
.check.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}
.check.checked::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 6rpx;
  width: 12rpx;
  height: 22rpx;
  border: solid #FFFFFF;
  border-width: 0 4rpx 4rpx 0;
  transform: rotate(45deg);
}
.check-label { margin-left: 8rpx; font-size: var(--fs-sm); color: var(--color-text-sub); }

.cart-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-soft);
  flex-shrink: 0;
}
.cart-info {
  flex: 1;
  margin-left: var(--space-sm);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 160rpx;
}
.cart-name {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: var(--fs-sm);
  color: var(--color-text);
  line-height: 1.4;
}
.cart-spec {
  font-size: var(--fs-xs);
  color: var(--color-text-sub);
}
.cart-bottom { display: flex; justify-content: space-between; align-items: center; }
.cart-price { color: var(--color-primary-dark); font-weight: 600; font-size: var(--fs-md); }
.cart-qty { display: flex; align-items: center; }
.qty-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: var(--color-bg-soft);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--color-text);
}
.qty-val {
  min-width: 64rpx;
  text-align: center;
  font-size: var(--fs-sm);
}
.cart-del {
  position: absolute;
  top: 8rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--color-text-muted);
  font-weight: 200;
}

.cart-bottom {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom, 0));
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: var(--color-card);
  padding: 16rpx var(--space-md);
  border-top: 2rpx solid var(--color-divider);
  z-index: 100;
  box-shadow: 0 -4rpx 16rpx rgba(42,38,34,.06);
}

/* 购物车列表底部避让固定栏 */
.cart-item:last-of-type {
  margin-bottom: calc(140rpx + env(safe-area-inset-bottom, 0));
}
.cart-bottom-left { display: flex; align-items: center; gap: var(--space-md); }
.cart-delete {
  color: var(--color-text-muted);
  font-size: var(--fs-xs);
  padding: 8rpx 0;
}
.cart-bottom-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-sm);
}
.total-area { display: flex; align-items: baseline; }
.total-label { color: var(--color-text-sub); font-size: var(--fs-sm); }
.total-price { color: var(--color-primary-dark); font-size: var(--fs-lg); font-weight: 600; }
.checkout-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #FFFFFF;
  border-radius: var(--radius-pill);
  font-size: var(--fs-sm);
  border: none;
}
.checkout-btn[disabled] { background: var(--color-text-disabled); }
.checkout-btn::after { border: none; }
