<view class="page-wrap with-tabbar">
  <!-- 骨架屏 -->
  <skeleton wx:if="{{loading}}" type="list" rows="{{4}}" />

  <!-- 错误状态 -->
  <error-state wx:elif="{{loadError}}" text="{{loadError}}" bind:retry="retry" />

  <!-- 空状态 -->
  <empty-state
    wx:elif="{{cartItems.length === 0}}"
    icon="/images/icons/cart.png"
    text="购物车还是空的"
    show-action="{{true}}"
    action-text="去逛逛"
    bind:action="onEmptyAction"
  />

  <!-- 购物车列表 -->
  <block wx:else>
    <view
      wx:for="{{cartItems}}"
      wx:key="productId-{{item.spec}}"
      wx:for-item="item"
      wx:for-index="idx"
      class="cart-item card"
    >
      <view class="cart-check" data-id="{{item.productId}}" data-spec="{{item.spec}}" bindtap="toggleItem">
        <view class="check {{selectedMap[item.productId + '_' + (item.spec || '')] ? 'checked' : ''}}"></view>
      </view>
      <image class="cart-img" src="{{item.image || '../../images/product-placeholder.png'}}" mode="aspectFill" lazy-load="{{true}}" />
      <view class="cart-info">
        <text class="cart-name">{{item.name || '商品已下架'}}</text>
        <text class="cart-spec">{{item.spec || ''}}</text>
        <view class="cart-bottom">
          <text class="cart-price">¥{{ item.priceText }}</text>
          <view class="cart-qty">
            <view class="qty-btn" data-index="{{idx}}" data-delta="-1" bindtap="changeQty">−</view>
            <text class="qty-val">{{item.quantity}}</text>
            <view class="qty-btn" data-index="{{idx}}" data-delta="1" bindtap="changeQty">+</view>
          </view>
        </view>
      </view>
      <view class="cart-del" data-index="{{idx}}" bindtap="deleteItem">×</view>
    </view>

    <!-- 底部结算栏 -->
    <view class="cart-bottom">
      <view class="cart-bottom-left">
        <view class="cart-check" bindtap="toggleAll">
          <view class="check {{allSelected ? 'checked' : ''}}"></view>
          <text class="check-label">全选</text>
        </view>
        <view class="cart-delete" bindtap="deleteSelected">
          <text>删除选中</text>
        </view>
      </view>
      <view class="cart-bottom-right">
        <view class="total-area">
          <text class="total-label">合计：</text>
          <text class="total-price">¥{{ totalPriceText }}</text>
        </view>
        <button class="checkout-btn" bindtap="goCheckout" disabled="{{selectedItemCount === 0}}">
          结算({{selectedCount}})
        </button>
      </view>
    </view>
  </block>
</view>
