.balance-section {
  display:flex; flex-direction:column; align-items:center;
  padding:60rpx 0; margin:20rpx;
  background:linear-gradient(135deg,#FDF8F3,#FFFBF7);
  border-radius:20rpx; border:2rpx solid #F5D6B8;
}
.balance-label { font-size:28rpx; color:#8B7E72; }
.balance-value { font-size:72rpx; font-weight:700; color:#E8A87C; margin:16rpx 0; }
.balance-value::before { content:'¥'; font-size:40rpx; }
.balance-hint { font-size:24rpx; color:#B0A59A; }
.form-section {
  background:#FFFFFF; margin:20rpx; padding:32rpx;
  border-radius:20rpx; box-shadow:0 2rpx 12rpx rgba(74,63,53,0.06);
}
.form-group { margin-bottom:28rpx; }
.form-label { font-size:28rpx; color:#4A3F35; display:block; margin-bottom:10rpx; font-weight:500; }
.amount-input-wrap {
  display:flex; align-items:center;
  border:2rpx solid #E8E0D8; border-radius:12rpx; padding:0 20rpx;
  height:80rpx;
}
.amount-symbol { font-size:32rpx; color:#4A3F35; font-weight:600; margin-right:8rpx; }
.amount-input { flex:1; height:100%; font-size:36rpx; color:#4A3F35; font-weight:600; }
.form-input {
  width:100%; height:72rpx; border:2rpx solid #E8E0D8; border-radius:12rpx;
  padding:0 20rpx; font-size:28rpx; color:#4A3F35;
}
.quick-amounts {
  display:flex; gap:16rpx; flex-wrap:wrap;
  margin-bottom:28rpx; padding:0 0 8rpx;
}
.quick-amount {
  padding:10rpx 24rpx; background:#F5F0EB; border-radius:12rpx;
  font-size:24rpx; color:#4A3F35; border:2rpx solid transparent;
}
.quick-active {
  background:#FFFBF7; border-color:#E8A87C; color:#E8A87C;
}
.tips-section {
  margin:20rpx; padding:24rpx 32rpx;
  background:#FDF8F3; border-radius:16rpx;
}
.tips-title { font-size:26rpx; font-weight:500; color:#4A3F35; display:block; margin-bottom:12rpx; }
.tips-text { font-size:24rpx; color:#8B7E72; display:block; line-height:1.8; }
.submit-wrap { padding:20rpx 32rpx 60rpx; }
.submit-btn {
  width:100%; height:88rpx; line-height:88rpx;
  background:linear-gradient(135deg,#E8A87C,#F5D6B8);
  color:#4A3F35; border:none; border-radius:44rpx; font-size:32rpx; font-weight:500;
}
.submit-btn::after { border:none; }
