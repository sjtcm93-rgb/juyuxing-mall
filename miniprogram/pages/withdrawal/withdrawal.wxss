.balance-card {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #FFFFFF;
  padding: var(--space-lg);
  text-align: center;
  margin: var(--space-md);
}
.balance-label { font-size: var(--fs-sm); opacity: 0.9; display: block; }
.balance-num { display: block; font-size: 60rpx; font-weight: 700; margin: 16rpx 0 8rpx; }
.balance-pending { font-size: var(--fs-xs); opacity: 0.85; }

.form { margin: var(--space-md); padding: 0 var(--space-md); }
.form-row {
  display: flex;
  align-items: center;
  padding: var(--space-md) 0;
  border-bottom: 2rpx solid var(--color-divider);
}
.form-row:last-of-type { border-bottom: none; }
.form-label { width: 140rpx; font-size: var(--fs-sm); color: var(--color-text-sub); flex-shrink: 0; }
.amount-input-wrap { flex: 1; display: flex; align-items: center; gap: 8rpx; }
.amount-symbol { font-size: var(--fs-md); color: var(--color-text); }
.amount-input { flex: 1; font-size: var(--fs-md); color: var(--color-text); }
.full-btn {
  background: var(--color-bg-soft);
  color: var(--color-primary-dark);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: var(--fs-xs);
}
.form-input { flex: 1; font-size: var(--fs-sm); color: var(--color-text); height: 48rpx; }
.form-tip { display: block; font-size: var(--fs-xs); color: var(--color-text-muted); padding: var(--space-sm) 0; }

.submit-wrap {
  padding: var(--space-md);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom, 0));
}
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #FFFFFF;
  border-radius: var(--radius-pill);
  font-size: var(--fs-md);
  border: none;
}
.submit-btn::after { border: none; }
.submit-btn[disabled] { background: var(--color-text-disabled); }

.records { margin: var(--space-md); padding: var(--space-md); }
.section-title {
  display: block;
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--space-sm);
}
.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 2rpx solid var(--color-divider);
}
.record-item:last-child { border-bottom: none; }
.record-info { display: flex; flex-direction: column; gap: 4rpx; }
.record-amount { font-size: var(--fs-md); font-weight: 600; color: var(--color-text); }
.record-time { font-size: var(--fs-xs); color: var(--color-text-muted); }
