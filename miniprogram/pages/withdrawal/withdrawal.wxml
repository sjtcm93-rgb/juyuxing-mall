<view class="page-wrap">
  <view class="balance-card card">
    <text class="balance-label">可提现金额（元）</text>
    <text class="balance-num">¥{{ availableText }}</text>
    <text wx:if="{{pendingCount > 0}}" class="balance-pending">处理中：¥{{ pendingAmountText }}（{{pendingCount}}笔）</text>
  </view>

  <view class="card form">
    <view class="form-row">
      <text class="form-label">提现金额</text>
      <view class="amount-input-wrap">
        <text class="amount-symbol">¥</text>
        <input class="amount-input" type="digit" placeholder="0.00" value="{{amount}}" bindinput="onAmount" />
        <view class="full-btn" bindtap="fullAmount">全部</view>
      </view>
    </view>
    <view class="form-row">
      <text class="form-label">收款人</text>
      <input class="form-input" placeholder="真实姓名" value="{{name}}" bindinput="onName" />
    </view>
    <view class="form-row">
      <text class="form-label">收款账号</text>
      <input class="form-input" placeholder="微信号/支付宝/银行卡号" value="{{account}}" bindinput="onAccount" />
    </view>
    <text class="form-tip">最低提现金额 10 元，提现申请会在 1-3 个工作日内审核</text>
  </view>

  <view class="submit-wrap safe-bottom">
    <button class="submit-btn" bindtap="submit" disabled="{{submitting}}">{{submitting ? '提交中...' : '提交申请'}}</button>
  </view>

  <view class="card records" wx:if="{{records.length > 0}}">
    <text class="section-title">提现记录</text>
    <view class="record-item" wx:for="{{records}}" wx:key="_id">
      <view class="record-info">
        <text class="record-amount">-¥{{ item.amountText }}</text>
        <text class="record-time">{{ item.createTimeText }}</text>
      </view>
      <status-tag status="{{item.status === 'success' ? 'settled' : (item.status === 'rejected' ? 'rejected' : 'pending')}}" />
    </view>
  </view>
</view>
