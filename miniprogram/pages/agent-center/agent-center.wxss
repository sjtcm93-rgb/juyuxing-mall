.agent-header {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #FFFFFF;
  padding: var(--space-xl) 0 var(--space-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: var(--space-md);
}
.agent-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
  overflow: hidden;
  background: rgba(255,255,255,0.2);
}
.agent-avatar image { width: 100%; height: 100%; }
.agent-name { font-size: var(--fs-lg); font-weight: 600; }
.agent-level {
  background: rgba(255,255,255,0.2);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: var(--fs-xs);
}

.stats-panel {
  display: flex;
  padding: var(--space-md);
  margin-bottom: var(--space-sm);
}
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.stat-value { font-size: var(--fs-lg); font-weight: 600; color: var(--color-primary-dark); }
.stat-label { font-size: var(--fs-xs); color: var(--color-text-sub); }
.stat-divider { width: 2rpx; background: var(--color-divider); }

.section { padding: var(--space-md); margin-bottom: var(--space-sm); }
.section-title {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--space-sm);
}
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-sm); }

.month-stats { display: flex; gap: var(--space-sm); }
.month-item {
  flex: 1;
  background: var(--color-bg-soft);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  text-align: center;
}
.month-value { display: block; font-size: var(--fs-md); font-weight: 600; color: var(--color-text); }
.month-label { font-size: var(--fs-xs); color: var(--color-text-sub); margin-top: 4rpx; display: block; }

.withdraw-info {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #FFFFFF;
  padding: var(--space-md);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-sm);
}
.withdraw-amount { display: block; font-size: var(--fs-xl); font-weight: 700; }
.withdraw-label { font-size: var(--fs-xs); opacity: 0.9; }
.withdraw-btn {
  display: block;
  text-align: center;
  background: var(--color-card);
  color: var(--color-primary-dark);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-pill);
  padding: 20rpx 0;
  font-size: var(--fs-sm);
}

.promo-row {
  display: flex;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 2rpx solid var(--color-divider);
}
.promo-row:last-of-type { border-bottom: none; }
.promo-label { width: 140rpx; font-size: var(--fs-sm); color: var(--color-text-sub); }
.promo-value { flex: 1; font-size: var(--fs-sm); color: var(--color-text); }
.copy-btn {
  background: var(--color-bg-soft);
  color: var(--color-primary-dark);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: var(--fs-xs);
}
.share-btn {
  margin-top: var(--space-md);
  width: 100%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #FFFFFF;
  border-radius: var(--radius-pill);
  height: 80rpx;
  line-height: 80rpx;
  font-size: var(--fs-sm);
  border: none;
}
.share-btn::after { border: none; }
.promo-hint {
  display: block;
  margin-top: var(--space-sm);
  font-size: var(--fs-xs);
  color: var(--color-text-muted);
  text-align: center;
}

.commission-item {
  display: flex;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 2rpx solid var(--color-divider);
}
.commission-item:last-child { border-bottom: none; }
.comm-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.comm-order { font-size: var(--fs-sm); color: var(--color-text); }
.comm-time { font-size: var(--fs-xs); color: var(--color-text-muted); }
.comm-amount-area { display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.comm-amount { font-size: var(--fs-md); font-weight: 600; color: var(--color-primary-dark); }
