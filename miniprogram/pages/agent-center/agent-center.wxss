.agent-header {
  display:flex; flex-direction:column; align-items:center;
  padding:60rpx 0 40rpx;
  background:linear-gradient(180deg,#FDF8F3,#FFFBF7);
}
.agent-avatar {
  width:120rpx; height:120rpx; border-radius:50%;
  border:4rpx solid #F5D6B8; overflow:hidden; margin-bottom:16rpx;
}
.agent-avatar image { width:100%; height:100%; }
.agent-name { font-size:34rpx; font-weight:600; color:#4A3F35; }
.agent-level {
  font-size:24rpx; color:#FFFFFF; background:linear-gradient(135deg,#E8A87C,#F5D6B8);
  padding:4rpx 24rpx; border-radius:20rpx; margin-top:12rpx;
}
.stats-panel {
  display:flex; align-items:center;
  background:#FFFFFF; margin:0 20rpx 20rpx; padding:32rpx 20rpx;
  border-radius:20rpx; box-shadow:0 2rpx 12rpx rgba(74,63,53,0.06);
}
.stat-item { flex:1; text-align:center; }
.stat-value { font-size:36rpx; font-weight:700; color:#E8A87C; display:block; }
.stat-label { font-size:22rpx; color:#B0A59A; margin-top:6rpx; display:block; }
.stat-divider { width:2rpx; height:60rpx; background:#F0E8E0; }
.section {
  background:#FFFFFF; margin:20rpx; padding:28rpx 32rpx;
  border-radius:20rpx; box-shadow:0 2rpx 12rpx rgba(74,63,53,0.06);
}
.section-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:16rpx; }
.section-title { font-size:30rpx; font-weight:600; color:#4A3F35; display:block; margin-bottom:16rpx; }
.section-more { font-size:24rpx; color:#B0A59A; }
.month-stats { display:flex; gap:20rpx; }
.month-item { flex:1; text-align:center; padding:16rpx; background:#FDF8F3; border-radius:14rpx; }
.month-value { font-size:30rpx; font-weight:600; color:#4A3F35; display:block; }
.month-label { font-size:22rpx; color:#B0A59A; margin-top:4rpx; display:block; }
.promo-section { margin-bottom:20rpx; }
.promo-code {
  display:flex; align-items:center;
  padding:16rpx; background:#FDF8F3; border-radius:12rpx; margin-bottom:16rpx;
}
.promo-label { font-size:24rpx; color:#8B7E72; margin-right:16rpx; }
.promo-value { flex:1; font-size:32rpx; font-weight:600; color:#4A3F35; letter-spacing:2rpx; }
.copy-btn {
  font-size:24rpx; color:#E8A87C; background:transparent;
  border:2rpx solid #E8A87C; border-radius:20rpx; height:52rpx; line-height:48rpx;
  padding:0 24rpx;
}
.copy-btn::after { border:none; }
.share-btn {
  width:100%; height:80rpx; line-height:80rpx;
  background:linear-gradient(135deg,#E8A87C,#F5D6B8);
  color:#4A3F35; border:none; border-radius:40rpx; font-size:30rpx; font-weight:500;
  margin-bottom:12rpx;
}
.share-btn::after { border:none; }
.promo-hint { font-size:22rpx; color:#B0A59A; display:block; text-align:center; }
.commission-item {
  display:flex; justify-content:space-between; align-items:center;
  padding:16rpx 0; border-bottom:2rpx solid #F0E8E0;
}
.commission-item:last-child { border-bottom:none; }
.comm-order { font-size:26rpx; color:#4A3F35; display:block; }
.comm-time { font-size:22rpx; color:#B0A59A; display:block; margin-top:4rpx; }
.comm-amount-area { text-align:right; }
.comm-amount { font-size:28rpx; color:#E0725A; font-weight:600; display:block; }
.comm-status { font-size:22rpx; color:#B0A59A; }
.comm-settled { color:#6ABF69; }

/* 提现管理 */
.withdraw-section {
  background:#FFFFFF; margin:20rpx; padding:28rpx 32rpx;
  border-radius:20rpx; box-shadow:0 2rpx 12rpx rgba(74,63,53,0.06);
  display:flex; flex-direction:column; align-items:center;
}
.withdraw-section .section-title {
  align-self:flex-start;
  font-size:30rpx; font-weight:600; color:#4A3F35; display:block; margin-bottom:16rpx;
}
.withdraw-info {
  display:flex; flex-direction:column; align-items:center;
  margin:20rpx 0;
}
.withdraw-amount {
  font-size:60rpx; font-weight:700; color:#E8A87C;
}
.withdraw-label {
  font-size:24rpx; color:#B0A59A; margin-top:8rpx;
}
.withdraw-btn {
  display:block; width:320rpx; height:72rpx; line-height:72rpx; text-align:center;
  background:linear-gradient(135deg,#E8A87C,#F5D6B8);
  color:#4A3F35; border:none; border-radius:36rpx;
  font-size:28rpx; font-weight:500; margin-top:8rpx;
}
