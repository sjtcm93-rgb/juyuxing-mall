@import '/style/tokens.wxss';

.page-wrap {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 32rpx;
}

/* ===== 顶部 Tab ===== */
.editor-tabs {
  display: flex;
  background: var(--color-card);
  border-bottom: 1rpx solid var(--color-border);
  position: sticky;
  top: 0;
  z-index: 10;
}
.et-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: var(--fs-md);
  color: var(--color-text-sub);
  position: relative;
  transition: color 0.2s;
}
.et-item.et-active {
  color: var(--color-primary);
  font-weight: 600;
}
.et-item.et-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 56rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
}

/* ===== 工具栏 ===== */
.toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: var(--color-card);
  border-bottom: 1rpx solid var(--color-border);
}
.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--color-bg);
  border-radius: var(--radius-pill);
  padding: 0 20rpx;
  height: 64rpx;
}
.si-icon-img { width:28rpx; height:28rpx; margin-right:12rpx; }
.si-input { flex: 1; font-size: var(--fs-sm); color: var(--color-text); background: transparent; }
.si-clear { font-size: 24rpx; color: var(--color-text-sub); padding: 0 8rpx; }

.filter-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: var(--color-bg);
  border-radius: var(--radius-pill);
  font-size: var(--fs-sm);
  color: var(--color-text);
}
.filter-arrow { font-size: 20rpx; color: var(--color-text-sub); }

.toolbar-btn {
  padding: 14rpx 24rpx;
  border-radius: var(--radius-pill);
  font-size: var(--fs-sm);
  background: var(--color-bg);
  color: var(--color-text);
}
.toolbar-btn.primary { background: var(--color-primary); color: #fff; }
.toolbar-btn.warn { background: var(--color-danger); color: #fff; }
.toolbar-tip {
  font-size: var(--fs-xs);
  color: var(--color-text-sub);
  margin-left: auto;
}

/* ===== 批量操作 ===== */
.batch-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFF3E0;
  padding: 16rpx 32rpx;
  border-bottom: 1rpx solid #FFE0B2;
}
.batch-count { font-size: var(--fs-sm); color: var(--color-primary); font-weight: 600; }
.batch-actions { display: flex; gap: 16rpx; }
.batch-btn {
  padding: 10rpx 20rpx;
  border-radius: var(--radius-pill);
  background: var(--color-card);
  font-size: var(--fs-sm);
  color: var(--color-text);
}
.batch-btn.warn { color: var(--color-danger); border: 1rpx solid var(--color-danger); }

/* ===== 商品列表 ===== */
.product-list { padding: 24rpx 32rpx; display: flex; flex-direction: column; gap: 20rpx; }
.pl-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  position: relative;
  transition: background 0.2s;
}
.pl-card.pl-selected { background: #FFF3E0; }
.pl-check {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  background: var(--color-card);
  flex-shrink: 0;
}
.pl-check.pl-check-on { background: var(--color-primary); border-color: var(--color-primary); }

.pl-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  flex-shrink: 0;
}
.pl-body { flex: 1; min-width: 0; }
.pl-title-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 8rpx; }
.pl-name { font-size: var(--fs-md); color: var(--color-text); font-weight: 500; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pl-status { padding: 4rpx 14rpx; border-radius: var(--radius-pill); font-size: var(--fs-xs); }
.pl-on { background: #E8F5E9; color: var(--color-success); }
.pl-off { background: #FFEBEE; color: var(--color-danger); }
.pl-sub { font-size: var(--fs-sm); color: var(--color-text-sub); display: block; margin-bottom: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pl-meta { display: flex; align-items: baseline; gap: 16rpx; flex-wrap: wrap; }
.pl-price { font-size: var(--fs-md); color: var(--color-primary); font-weight: 600; }
.pl-original { font-size: var(--fs-xs); color: var(--color-text-sub); text-decoration: line-through; }
.pl-stock, .pl-sales { font-size: var(--fs-xs); color: var(--color-text-sub); }

.list-foot { text-align: center; color: var(--color-text-sub); font-size: var(--fs-xs); padding: 24rpx 0; }

/* ===== 轮播图列表 ===== */
.banner-list { padding: 24rpx 32rpx; display: flex; flex-direction: column; gap: 20rpx; }
.bn-card {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  position: relative;
  transition: transform 0.15s, opacity 0.15s;
}
.bn-card.bn-off { opacity: 0.5; }
.bn-card.bn-dragging { transform: scale(1.02); box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15); z-index: 5; }
.bn-drag { color: var(--color-text-sub); font-size: 32rpx; padding: 0 8rpx; align-self: center; user-select: none; }
.bn-image { width: 200rpx; height: 120rpx; border-radius: var(--radius-sm); background: var(--color-bg); flex-shrink: 0; }
.bn-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.bn-title { font-size: var(--fs-md); color: var(--color-text); font-weight: 500; }
.bn-link { font-size: var(--fs-xs); color: var(--color-text-sub); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bn-meta { display: flex; align-items: center; gap: 16rpx; margin-top: auto; }
.bn-sort { font-size: var(--fs-xs); color: var(--color-text-sub); }
.bn-status { padding: 4rpx 12rpx; border-radius: var(--radius-pill); font-size: var(--fs-xs); }
.bn-on { background: #E8F5E9; color: var(--color-success); }
.bn-off-pill { background: #FFEBEE; color: var(--color-danger); }
.bn-actions { display: flex; flex-direction: column; gap: 8rpx; align-self: center; }
.bn-action {
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--color-bg);
  font-size: var(--fs-xs);
  color: var(--color-text);
  text-align: center;
}
.bn-action.danger { color: var(--color-danger); }

/* ===== Modal ===== */
.modal-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 100;
  display: flex; align-items: flex-end; justify-content: center;
}
.modal-card {
  width: 100%;
  max-width: 750rpx;
  height: 90vh;
  background: var(--color-bg);
  border-radius: 32rpx 32rpx 0 0;
  display: flex; flex-direction: column;
  overflow: hidden;
  animation: slideUp 0.25s ease-out;
}
.modal-card-sm { height: 70vh; }
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

.modal-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 32rpx;
  background: var(--color-card);
  border-bottom: 1rpx solid var(--color-border);
  flex-shrink: 0;
}
.modal-title { font-size: var(--fs-lg); font-weight: 600; color: var(--color-text); }
.modal-close { font-size: 36rpx; color: var(--color-text-sub); padding: 8rpx; }

.modal-body { flex: 1; padding: 24rpx 32rpx; }

.modal-footer {
  display: flex; gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--color-card);
  border-top: 1rpx solid var(--color-border);
  flex-shrink: 0;
}
.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: var(--radius-pill);
  font-size: var(--fs-md);
}
.modal-btn.cancel { background: var(--color-bg); color: var(--color-text); }
.modal-btn.primary { background: var(--color-primary); color: #fff; }

/* ===== Form ===== */
.form-group { margin-bottom: 28rpx; }
.form-label { display: block; font-size: var(--fs-sm); color: var(--color-text); margin-bottom: 12rpx; font-weight: 500; }
.form-label.required::before { content: '*'; color: var(--color-danger); margin-right: 4rpx; }
.form-input {
  width: 100%;
  padding: 16rpx 20rpx;
  background: var(--color-card);
  border-radius: var(--radius-sm);
  font-size: var(--fs-sm);
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
  box-sizing: border-box;
}
.form-hint { font-size: var(--fs-xs); color: var(--color-text-sub); margin-top: 8rpx; display: block; }
.form-row-2 { display: flex; gap: 20rpx; }
.form-row-2 .form-group { flex: 1; }

.radio-group { display: flex; gap: 16rpx; }
.radio-item {
  flex: 1;
  padding: 16rpx;
  text-align: center;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: var(--fs-sm);
  color: var(--color-text);
  background: var(--color-card);
}
.radio-item.radio-active { border-color: var(--color-primary); background: #FFF3E0; color: var(--color-primary); }

/* ===== 规格 ===== */
.specs-list { display: flex; flex-direction: column; gap: 12rpx; }
.spec-row { display: flex; gap: 12rpx; align-items: center; }
.spec-name { flex: 2; }
.spec-stock { flex: 1; }
.spec-del { font-size: 32rpx; color: var(--color-danger); padding: 0 12rpx; }
.add-spec-btn {
  padding: 16rpx;
  text-align: center;
  border: 1rpx dashed var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-primary);
  font-size: var(--fs-sm);
  background: var(--color-card);
}

/* ===== 图片网格 ===== */
.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.img-cell {
  position: relative;
  width: 100%;
  padding-top: 100%;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--color-card);
}
.img-cell image { position: absolute; inset: 0; width: 100%; height: 100%; }
.img-del {
  position: absolute; top: 4rpx; right: 4rpx;
  width: 40rpx; height: 40rpx;
  background: rgba(0,0,0,0.6); color: #fff;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx;
}
.img-move-left, .img-move-right {
  position: absolute; bottom: 4rpx;
  width: 40rpx; height: 40rpx;
  background: rgba(0,0,0,0.5); color: #fff;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
}
.img-move-left { left: 4rpx; }
.img-move-right { right: 4rpx; }

.img-add {
  width: 100%;
  padding-top: 100%;
  position: relative;
  border: 2rpx dashed var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-card);
  display: flex; align-items: center; justify-content: center;
}
.img-add-icon, .img-add-text {
  position: absolute; left: 50%; transform: translateX(-50%);
  color: var(--color-text-sub);
}
.img-add-icon { top: 30%; font-size: 48rpx; }
.img-add-text { top: 60%; font-size: var(--fs-xs); }

/* ===== 富文本 ===== */
.editor-toolbar {
  display: flex; gap: 12rpx;
  padding: 12rpx;
  background: var(--color-card);
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  border: 1rpx solid var(--color-border);
  border-bottom: none;
  flex-wrap: wrap;
}
.et-btn {
  width: 60rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  font-size: var(--fs-sm);
  color: var(--color-text);
}
.form-editor {
  width: 100%;
  min-height: 280rpx;
  padding: 20rpx;
  background: var(--color-card);
  border-radius: 0 0 var(--radius-sm) var(--radius-sm);
  border: 1rpx solid var(--color-border);
  border-top: none;
  box-sizing: border-box;
}

/* ===== 轮播图上传 ===== */
.banner-upload {
  position: relative;
  width: 100%;
  padding-top: 53.3%;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
}
.banner-upload-img { position: absolute; inset: 0; width: 100%; height: 100%; }
.banner-upload-overlay {
  position: absolute; bottom: 12rpx; right: 12rpx;
  display: flex; gap: 12rpx;
}
.bu-btn {
  padding: 10rpx 20rpx;
  background: rgba(0,0,0,0.6); color: #fff;
  border-radius: var(--radius-pill);
  font-size: var(--fs-xs);
}
.bu-btn.danger { background: rgba(255,0,0,0.7); }

.banner-upload-add {
  position: absolute; inset: 0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 8rpx;
  color: var(--color-text-sub);
}
.bua-icon { font-size: 56rpx; }
.bua-text { font-size: var(--fs-sm); }
.bua-tip { font-size: var(--fs-xs); }
