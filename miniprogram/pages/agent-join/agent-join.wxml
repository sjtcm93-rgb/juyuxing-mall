<view class="page-wrap">
  <!-- 代理介绍 -->
  <view class="intro-section">
    <text class="intro-title">成为橘与杏代理</text>
    <text class="intro-desc">分享好产品，成就一份属于自己的事业</text>
  </view>

  <!-- 优势 -->
  <view class="benefits">
    <view class="benefit-item">
      <text class="benefit-icon">💰</text>
      <view class="benefit-text">
        <text class="benefit-title">高额佣金</text>
        <text class="benefit-desc">每笔销售可获得10-20%佣金</text>
      </view>
    </view>
    <view class="benefit-item">
      <text class="benefit-icon">🔗</text>
      <view class="benefit-text">
        <text class="benefit-title">专属链接</text>
        <text class="benefit-desc">自动生成推广码和分享链接</text>
      </view>
    </view>
    <view class="benefit-item">
      <text class="benefit-icon">🔄</text>
      <view class="benefit-text">
        <text class="benefit-title">永久绑定</text>
        <text class="benefit-desc">客户后续消费持续享有佣金</text>
      </view>
    </view>
    <view class="benefit-item">
      <text class="benefit-icon">📦</text>
      <view class="benefit-text">
        <text class="benefit-title">无需囤货</text>
        <text class="benefit-desc">我们负责发货，你专注分享</text>
      </view>
    </view>
  </view>

  <!-- 申请表单 -->
  <view class="form-section" wx:if="{{!applied}}">
    <text class="form-title">申请信息</text>
    <view class="form-group">
      <text class="form-label">姓名</text>
      <input class="form-input" placeholder="请输入真实姓名" bindinput="onNameInput" />
    </view>
    <view class="form-group">
      <text class="form-label">手机号</text>
      <input class="form-input" type="phone" placeholder="请输入手机号" bindinput="onPhoneInput" />
    </view>
    <view class="form-group">
      <text class="form-label">微信号</text>
      <input class="form-input" placeholder="请输入微信号" bindinput="onWechatInput" />
    </view>
    <view class="form-group">
      <text class="form-label">申请理由</text>
      <textarea class="form-textarea" placeholder="简单介绍一下你自己（选填）" bindinput="onReasonInput"></textarea>
    </view>
    <button class="submit-btn {{submitting ? 'btn-disabled' : ''}}" bindtap="submitApply" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交申请'}}
    </button>
  </view>

  <!-- 申请成功 -->
  <view class="success-section" wx:if="{{applied}}">
    <text class="success-icon">✅</text>
    <text class="success-title">申请已提交</text>
    <text class="success-desc">我们会在1-3个工作日内审核你的申请，请留意微信通知</text>
    <navigator url="/pages/agent-center/agent-center" class="success-btn">查看代理中心</navigator>
  </view>
</view>
