.intro-section {
  text-align:center; padding:60rpx 40rpx 40rpx;
}
.intro-title { font-size:40rpx; font-weight:700; color:#4A3F35; display:block; }
.intro-desc { font-size:26rpx; color:#8B7E72; margin-top:12rpx; display:block; }
.benefits { padding:0 20rpx; }
.benefit-item {
  display:flex; align-items:center;
  background:#FFFFFF; margin-bottom:16rpx; padding:28rpx 32rpx;
  border-radius:18rpx; box-shadow:0 2rpx 12rpx rgba(74,63,53,0.06);
}
.benefit-icon { font-size:40rpx; margin-right:20rpx; }
.benefit-text { flex:1; }
.benefit-title { font-size:28rpx; font-weight:500; color:#4A3F35; display:block; }
.benefit-desc { font-size:24rpx; color:#8B7E72; margin-top:4rpx; display:block; }
.form-section {
  background:#FFFFFF; margin:20rpx; padding:32rpx;
  border-radius:20rpx; box-shadow:0 2rpx 12rpx rgba(74,63,53,0.06);
}
.form-title { font-size:30rpx; font-weight:600; color:#4A3F35; display:block; margin-bottom:24rpx; }
.form-group { margin-bottom:24rpx; }
.form-label { font-size:26rpx; color:#4A3F35; display:block; margin-bottom:8rpx; }
.form-input {
  width:100%; height:72rpx; border:2rpx solid #E8E0D8; border-radius:12rpx;
  padding:0 20rpx; font-size:28rpx; color:#4A3F35;
}
.form-textarea {
  width:100%; height:160rpx; border:2rpx solid #E8E0D8; border-radius:12rpx;
  padding:16rpx 20rpx; font-size:28rpx; color:#4A3F35;
}
.submit-btn {
  width:100%; height:88rpx; line-height:88rpx;
  background:linear-gradient(135deg,#E8A87C,#F5D6B8);
  color:#4A3F35; border:none; border-radius:44rpx; font-size:32rpx; font-weight:500;
  margin-top:16rpx;
}
.submit-btn::after { border:none; }
.success-section {
  display:flex; flex-direction:column; align-items:center;
  padding:100rpx 40rpx;
}
.success-icon { font-size:80rpx; margin-bottom:24rpx; }
.success-title { font-size:36rpx; font-weight:600; color:#4A3F35; margin-bottom:12rpx; }
.success-desc { font-size:26rpx; color:#8B7E72; text-align:center; line-height:1.6; }
.success-btn {
  margin-top:40rpx; padding:20rpx 80rpx;
  background:linear-gradient(135deg,#E8A87C,#F5D6B8);
  color:#4A3F35; border-radius:44rpx; font-size:30rpx; font-weight:500;
}
