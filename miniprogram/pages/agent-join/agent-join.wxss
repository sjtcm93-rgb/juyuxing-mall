.banner {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #FFFFFF;
  text-align: center;
  padding: var(--space-lg);
  margin: var(--space-md);
}
.banner-icon-img { width:80rpx; height:80rpx; display:block; }
.banner-title { display: block; font-size: var(--fs-lg); font-weight: 600; margin-top: var(--space-sm); }
.banner-desc { display: block; font-size: var(--fs-sm); opacity: 0.9; margin-top: 4rpx; }

.benefits {
  display: flex;
  flex-wrap: wrap;
  margin: var(--space-md);
  padding: var(--space-md);
}
.benefit-item { width: 50%; text-align: center; padding: var(--space-sm) 0; }
.benefit-icon { display: block; font-size: 48rpx; margin-bottom: 6rpx; }
.benefit-label { display: block; font-size: var(--fs-xs); color: var(--color-text-sub); }

/* 如何赚钱 */
.how-it-works {
  margin: var(--space-md);
  padding: var(--space-md);
}
.step-item {
  display: flex;
  align-items: flex-start;
  padding: var(--space-sm) 0;
}
.step-num {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #FFFFFF;
  font-size: var(--fs-xs);
  font-weight: 600;
  flex-shrink: 0;
  margin-right: var(--space-sm);
}
.step-content { flex: 1; }
.step-title { display: block; font-size: var(--fs-sm); font-weight: 600; color: var(--color-text); }
.step-desc { display: block; font-size: var(--fs-xs); color: var(--color-text-sub); margin-top: 4rpx; }

.section-title {
  display: block;
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--space-sm);
}

.form { margin: var(--space-md); padding: 0 var(--space-md); }
.form-row {
  display: flex;
  align-items: center;
  padding: var(--space-md) 0;
  border-bottom: 2rpx solid var(--color-divider);
}
.form-row:last-child { border-bottom: none; }
.form-label { width: 140rpx; font-size: var(--fs-sm); color: var(--color-text-sub); flex-shrink: 0; }
.form-input { flex: 1; font-size: var(--fs-sm); color: var(--color-text); height: 48rpx; }
.form-row-textarea { align-items: flex-start; }
.form-textarea { flex: 1; min-height: 120rpx; font-size: var(--fs-sm); color: var(--color-text); padding: 8rpx 0; }

.submit-wrap {
  padding: var(--space-md);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom, 0));
}
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #FFFFFF;
  border-radius: var(--radius-pill);
  font-size: var(--fs-md);
  border: none;
}
.submit-btn::after { border: none; }
.submit-btn[disabled] { background: var(--color-text-disabled); }
